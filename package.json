{
  "name": "app-calendario-palestra",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply app-calendario-palestra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply app-calendario-palestra-db --remote",
    "db:seed:local": "node --experimental-strip-types server/db/seed.ts --local",
    "db:seed:remote": "node --experimental-strip-types server/db/seed.ts --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.4",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
